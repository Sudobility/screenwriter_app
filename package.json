{
  "name": "screenwriter_app",
  "version": "0.1.27",
  "private": true,
  "type": "module",
  "description": "Fadewright web app (Vite + React): dev login, dashboard, script editor, snapshots",
  "license": "BUSL-1.1",
  "author": "Sudobility",
  "scripts": {
    "generate:cf-env": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-cloudflare-env.ts -o /tmp/generate-cloudflare-env.ts && bunx tsx /tmp/generate-cloudflare-env.ts",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "e2e": "playwright test",
    "icons": "bun run scripts/make-icons.mjs",
    "process:static": "curl -sL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/process-static-files.ts -o /tmp/process-static-files.ts && bunx tsx /tmp/process-static-files.ts",
    "seo:fetch": "curl -fsSL https://raw.githubusercontent.com/johnqh/workflows/main/scripts/generate-seo-assets-v2.mjs -o /tmp/generate-seo-assets.mjs",
    "generate:sitemap": "bun run seo:fetch && node /tmp/generate-seo-assets.mjs public",
    "prerender": "node scripts/prerender.mjs",
    "prerender:install": "bunx playwright install --with-deps chromium",
    "generate": "bun run process:static && bun run generate:sitemap && bun run prerender:install && bun run prerender"
  },
  "dependencies": {
    "@heroicons/react": "~2.2.0",
    "@revenuecat/purchases-js": "~1.73.1",
    "@sudobility/auth-components": "^1.0.12",
    "@sudobility/auth_lib": "^0.0.121",
    "@sudobility/building_blocks": "^0.0.343",
    "@sudobility/components": "^5.3.46",
    "@sudobility/consumables_client": "^0.0.38",
    "@sudobility/consumables_pages": "^0.0.70",
    "@sudobility/design": "^1.1.66",
    "@sudobility/di": "^1.5.82",
    "@sudobility/di_web": "^0.1.264",
    "@sudobility/entity_client": "^0.0.57",
    "@sudobility/screenwriter_client": "^0.1.20",
    "@sudobility/screenwriter_lib": "^0.1.19",
    "@sudobility/screenwriter_types": "^0.1.15",
    "@sudobility/seo_lib": "^0.0.49",
    "@sudobility/types": "^1.9.76",
    "@sudobility/writing_core": "^0.1.6",
    "@sudobility/writing_ui": "^0.1.12",
    "@tanstack/react-query": "~5.104.5",
    "class-variance-authority": "~0.7.1",
    "clsx": "~2.1.1",
    "firebase": "~12.19.0",
    "i18next": "~26.3.1",
    "i18next-browser-languagedetector": "~8.2.1",
    "i18next-http-backend": "~4.0.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-helmet-async": "~3.0.0",
    "react-i18next": "~17.0.8",
    "react-router-dom": "~7.18.4",
    "tailwind-merge": "~3.7.0",
    "zustand": "~5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "~1.64.1",
    "@types/node": "~26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~5.1.2",
    "autoprefixer": "~10.6.1",
    "fake-indexeddb": "~6.2.6",
    "jsdom": "~30.1.3",
    "postcss": "~8.5.31",
    "tailwindcss": "~3.4.19",
    "typescript": "~6.0.3",
    "vite": "~7.3.7",
    "vitest": "~4.1.12",
    "playwright": "~1.64.1",
    "tsx": "~4.23.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/screenwriter_app.git"
  }
}
