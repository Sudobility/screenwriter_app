# API origin (screenwriter_api). No trailing slash.
VITE_API_URL=http://localhost:8036
# 1 = the login's email form becomes the dev login (email only, no password) instead of real Firebase
# email/password. Needs the API to run with AI_TEST_MODE=1. Unset it to use real email/password sign-in.
VITE_DEV_AUTH=1

# Branding (also used as the <title>%VITE_APP_NAME%</title> substitution in index.html, so keep it non-empty).
VITE_APP_NAME=ViaInk
VITE_APP_DOMAIN=viaink.app
VITE_COMPANY_NAME=Sudobility Inc.

# Workspace switcher, Workspaces, Members and Invitations dashboard sections.
VITE_SHOW_ENTITIES=false

# Firebase web config: read by src/auth/backend.ts via src/config.ts's FIREBASE_CONFIG. Real email/password and
# Google sign-in are offered only when apiKey + projectId are both present (the API side also needs its own
# FIREBASE_* admin credentials configured). With VITE_DEV_AUTH=1 the dev login replaces the email/password form.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=

# RevenueCat Web SDK public keys. VITE_DEV_MODE=true selects the sandbox key.
VITE_REVENUECAT_API_KEY=
VITE_REVENUECAT_API_KEY_SANDBOX=
VITE_DEV_MODE=false
