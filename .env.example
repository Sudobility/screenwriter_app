# API origin (screenwriter_api). No trailing slash.
VITE_API_URL=http://localhost:8036
# 1 = show the dev login (email only, no password). Needs the API to run with AI_TEST_MODE=1.
VITE_DEV_AUTH=1

# Branding (also used as the <title>%VITE_APP_NAME%</title> substitution in index.html, so keep it non-empty).
VITE_APP_NAME=ViaInk
VITE_APP_DOMAIN=viaink.app
VITE_COMPANY_NAME=Sudobility Inc.

# Firebase web config: NOT YET READ by the app (real Firebase login isn't wired up; see src/auth/index.ts and
# CLAUDE.md). Reserved for when `createAuthPort()` is extended to return a real Firebase-backed AuthPort when
# these are present; the API side also needs its own FIREBASE_* admin credentials configured.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
